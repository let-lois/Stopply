{
  "name": "letlois-bi",
  "version": "0.1.0",
  "private": true,
  "description": "LetLois BI: multi tenant marketing attribution platform",
  "scripts": {
    "dev": "pnpm --parallel --filter @letlois/api --filter web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r --no-bail test",
    "migrate:control": "node scripts/migrate-control.mjs",
